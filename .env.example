# Frontend (Vite) — values are embedded in the build
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Tracking — loaded only after cookie consent. Leave empty to skip a tracker.
VITE_GA_MEASUREMENT_ID=""    # GA4, e.g. G-XXXXXXXXXX
VITE_GTM_CONTAINER_ID=""     # Google Tag Manager, e.g. GTM-XXXXXXX
VITE_META_PIXEL_ID=""        # Meta Pixel, e.g. 1234567890

# Edge function secrets (set in the backend, NOT in this file):
#   HCAPTCHA_SECRET     — hCaptcha secret key; captcha is enforced once it is set
#   RESEND_API_KEY      — Resend key
#   RESEND_FROM_EMAIL   — sender on a verified domain, e.g. "Renovivo <office@renovivo.bg>"
